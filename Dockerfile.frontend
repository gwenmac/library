# ── Frontend Dockerfile ──
# Multi-stage: Node build → Nginx serve

FROM node:18-alpine AS build

WORKDIR /app

COPY library-vue/package.json library-vue/package-lock.json ./
RUN npm ci

COPY library-vue/ .
RUN npm run build

# ── Runtime ──
FROM nginx:alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom Nginx config
COPY deploy/nginx.conf /etc/nginx/conf.d/library.conf

# Copy built Vue app
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80 443
