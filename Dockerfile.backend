# ── Backend Dockerfile ──
# Multi-stage build: Gradle build → JRE 17 runtime

FROM eclipse-temurin:17-jdk AS build

WORKDIR /app

# Copy Gradle wrapper and config first (layer caching)
COPY gradle/ gradle/
COPY gradlew settings.gradle gradle.properties ./
RUN chmod +x gradlew

COPY lib/build.gradle lib/build.gradle

# Create source dir so Gradle can resolve the project
RUN mkdir -p lib/src/main/java

# Download dependencies (cached unless build.gradle changes)
RUN ./gradlew :lib:dependencies --no-daemon || true

# Copy source and build
COPY lib/src lib/src
RUN ./gradlew :lib:bootJar --no-daemon

# ── Runtime ──
FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=build /app/lib/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
